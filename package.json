{
  "name": "logos-international",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "assets:images": "node scripts/generate-product-images.mjs",
    "build": "node scripts/generate-product-images.mjs && node scripts/generate-discovery-assets.mjs && vite build && node scripts/postbuild-seo.mjs",
    "preview": "vite preview --host=0.0.0.0 --port=4173",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test tests/e2e.spec.js",
    "check": "npm run lint && npm run build",
    "report:seo": "python scripts/generate-seo-report.py",
    "deploy:check": "npm run lint && npm run build && npm audit --omit=dev"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
